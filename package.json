{
  "name": "pullup",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "start:tui": "PULLUP_PROVIDERS=terminal bun src/index.ts",
    "start:imessage": "PULLUP_PROVIDERS=imessage bun src/index.ts",
    "start:both": "PULLUP_PROVIDERS=both bun src/index.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "openai": "^6.42.0",
    "spectrum-ts": "^1.18.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/bun": "latest"
  }
}
