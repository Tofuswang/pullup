# Photon Spectrum credentials for managed iMessage cloud mode.
# Leave these blank for terminal-only local testing.
PROJECT_ID=
PROJECT_SECRET=

# Optional LLM gateway. The agent runs with a deterministic fallback if unset.
LLM_KEY=
LLM_BASE_URL=https://your-api-gateway.com/v1
LLM_MODEL=deepseek/deepseek-v3
