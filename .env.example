PROJECT_ID=
PROJECT_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# terminal | imessage | both
PULLUP_PROVIDERS=terminal

# Keep traces visible while developing. Set to 0 for real user testing.
PULLUP_SHOW_AGENT_TRACE=1

# Keep Spectrum telemetry on while debugging iMessage delivery. Set to 0 to disable.
PULLUP_SPECTRUM_TELEMETRY=1

# One-shot outbound test target. Must be allowed by the Spectrum project.
IMESSAGE_TEST_TARGET=
